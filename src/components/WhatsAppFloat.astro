---
import { whatsappHref } from "../data/site";
---

<a
  href={whatsappHref()}
  target="_blank"
  rel="noreferrer"
  class="group fixed right-5 z-50 inline-flex items-center gap-2.5 rounded-full bg-[#25D366] py-2.5 pl-2.5 pr-4 text-white shadow-[0_10px_28px_rgba(18,140,70,0.45)] transition hover:bg-[#1ebe57] hover:shadow-[0_12px_32px_rgba(18,140,70,0.55)]"
  style="bottom: max(1.25rem, env(safe-area-inset-bottom, 0px));"
  aria-label="Cotizar por WhatsApp"
>
  <span class="relative isolate inline-flex h-11 w-11 shrink-0 items-center justify-center">
    <span class="absolute inset-0 -z-10 animate-ping rounded-full bg-white/25 motion-reduce:animate-none"></span>
    <svg viewBox="0 0 24 24" class="h-7 w-7 fill-current" aria-hidden="true">
      <path d="M12.04 2C6.58 2 2.15 6.43 2.15 11.89c0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.39a9.86 9.86 0 0 0 4.74 1.21h.01c5.46 0 9.89-4.43 9.89-9.89C21.94 6.43 17.5 2 12.04 2Zm5.83 13.98c-.24.68-1.42 1.3-1.97 1.38-.51.08-1.16.11-1.87-.12-.43-.13-.98-.32-1.68-.62-2.96-1.28-4.88-4.27-5.03-4.47-.15-.2-1.22-1.62-1.22-3.1 0-1.47.77-2.2 1.05-2.5.27-.3.6-.37.8-.37h.57c.18 0 .43-.07.67.51.24.6.82 2.06.89 2.21.07.15.12.33.02.53-.1.2-.15.32-.3.5-.15.17-.31.38-.44.51-.15.15-.3.31-.13.61.17.3.76 1.25 1.63 2.03 1.12 1 2.06 1.31 2.36 1.46.3.15.47.12.65-.08.17-.2.74-.86.94-1.16.2-.3.4-.25.67-.15.27.1 1.71.8 2 .95.3.15.49.22.56.35.08.12.08.71-.16 1.39Z"></path>
    </svg>
  </span>
  <span class="pr-0.5 text-sm font-semibold tracking-wide">Cotizar</span>
</a>
