---
import { gallery } from "../data/products";
---

<section id="galeria" class="scroll-mt-20 bg-charcoal py-20 text-white lg:py-28">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-stone">Planta y producto</p>
        <h2 class="mt-3 font-display text-4xl uppercase leading-none sm:text-5xl">Así se ve la calidad</h2>
      </div>
      <p class="max-w-sm text-sm text-stone">Fotos reales de patio, inventario y piezas listas para obra.</p>
    </div>

    <div class="mt-12 grid grid-cols-2 gap-3 md:grid-cols-4">
      {gallery.map((photo, index) => (
        <figure class:list={["overflow-hidden", index === 0 || index === 5 ? "md:col-span-2 md:row-span-2" : ""]}>
          <img
            src={photo.src}
            alt={photo.alt}
            class="h-full min-h-40 w-full object-cover transition duration-500 hover:scale-105 md:min-h-52"
            loading="lazy"
          />
        </figure>
      ))}
    </div>
  </div>
</section>
