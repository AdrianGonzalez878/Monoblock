---
import { site, whatsappHref } from "../data/site";
import SocialLinks from "./SocialLinks.astro";

const year = new Date().getFullYear();

const nav = [
  { href: "#productos", label: "Productos" },
  { href: "#nosotros", label: "Nosotros" },
  { href: "#catalogo", label: "Catálogo" },
  { href: "#galeria", label: "Galería" },
  { href: "#preguntas", label: "Preguntas" },
  { href: "#contacto", label: "Contacto" },
  { href: "#ubicacion", label: "Ubicación" },
];
---

<footer class="bg-ink text-stone">
  <div class="h-1 bg-brand"></div>

  <div class="mx-auto max-w-7xl px-5 pt-14 lg:px-8 lg:pt-20">
    <div class="flex flex-col gap-8 border-b border-white/10 pb-12 lg:flex-row lg:items-end lg:justify-between lg:pb-16">
      <div>
        <a href="#inicio" class="inline-flex items-center gap-4" aria-label={site.name}>
          <img
            src="/images/logo-oficial.png"
            alt=""
            class="h-14 w-14 bg-white object-cover object-[center_18%] p-1"
          />
          <span class="leading-none">
            <span class="block font-display text-3xl tracking-wide text-white sm:text-4xl">
              MONO<span class="text-brand">BLOCK</span>
            </span>
            <span class="mt-1 block text-[11px] font-semibold tracking-[0.4em] text-stone">BLOQUERA</span>
          </span>
        </a>
        <p class="mt-6 max-w-md font-display text-2xl uppercase leading-tight text-white sm:text-3xl">
          {site.slogan}
        </p>
        <p class="mt-3 max-w-md text-sm leading-relaxed">
          {site.tagline} {site.factoryLine} Fabricación y entrega de productos de concreto en Oaxaca.
        </p>
      </div>

      <a
        href={whatsappHref()}
        class="inline-flex shrink-0 items-center justify-center bg-brand px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-brand-hot"
      >
        Cotizar por WhatsApp
      </a>
    </div>

    <div class="grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4 lg:gap-12 lg:py-16">
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-[0.28em] text-brand">Navegación</p>
        <nav class="mt-5 flex flex-col gap-3" aria-label="Pie de página">
          {nav.map((link) => (
            <a href={link.href} class="text-sm transition hover:text-white">
              {link.label}
            </a>
          ))}
        </nav>
      </div>

      <div>
        <p class="text-[11px] font-semibold uppercase tracking-[0.28em] text-brand">Contacto</p>
        <ul class="mt-5 space-y-4 text-sm">
          <li>
            <p class="text-white/50">Teléfono / WhatsApp</p>
            <a href={site.phoneHref} class="mt-1 block text-white transition hover:text-brand">{site.phone}</a>
          </li>
          <li>
            <p class="text-white/50">Correo</p>
            <a href={`mailto:${site.email}`} class="mt-1 block break-all text-white transition hover:text-brand">
              {site.email}
            </a>
          </li>
        </ul>
      </div>

      <div>
        <p class="text-[11px] font-semibold uppercase tracking-[0.28em] text-brand">Planta</p>
        <p class="mt-5 text-sm leading-relaxed text-stone">{site.address}</p>
        <p class="mt-4 text-sm text-white">{site.leadTime}</p>
        <p class="mt-1 text-xs uppercase tracking-[0.18em] text-white/45">Tiempo de fabricación</p>
      </div>

      <div>
        <p class="text-[11px] font-semibold uppercase tracking-[0.28em] text-brand">Síguenos</p>
        <p class="mt-5 text-sm leading-relaxed">
          Producto, patio y obra en nuestras redes.
        </p>
        <div class="mt-5">
          <SocialLinks tone="dark" />
        </div>
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-7xl flex-col gap-3 px-5 py-6 text-xs sm:flex-row sm:items-center sm:justify-between lg:px-8">
      <p>© {year} {site.name}. {site.factoryLine}</p>
      <p class="shrink-0 sm:text-right">
        Desarrollado por&nbsp;<a href="https://argaweb.com" target="_blank" rel="noreferrer" class="text-white transition hover:text-brand">argaweb.com</a>
      </p>
    </div>
  </div>
</footer>
