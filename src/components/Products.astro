---
import { categories } from "../data/products";
---

<section id="productos" class="scroll-mt-20 bg-sand py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-brand">Línea de productos</p>
      <h2 class="mt-3 font-display text-4xl uppercase leading-none text-ink sm:text-5xl">
        Concreto para obra y urbanización
      </h2>
      <p class="mt-4 text-concrete">
        Amplia variedad de productos de concreto vibrocomprimidos en Oaxaca para constructores, arquitectos, ingenieros, desarrolladores y público en general.
      </p>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {categories.map((item) => (
        <article class="group overflow-hidden bg-white">
          <div class="aspect-[4/3] overflow-hidden">
            <img
              src={item.image}
              alt={item.alt}
              class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
              loading="lazy"
            />
          </div>
          <div class="border-t-2 border-brand p-5">
            <h3 class="font-display text-2xl uppercase text-ink">{item.name}</h3>
            <p class="mt-1 text-sm text-concrete">{item.summary}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
