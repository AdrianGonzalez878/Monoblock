---
import { reasons } from "../data/products";
---

<section id="por-que" class="scroll-mt-20 bg-ink py-20 text-white lg:py-28">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="flex flex-col justify-between gap-8 lg:flex-row lg:items-end">
      <div class="max-w-2xl">
        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-stone">Por qué elegirnos</p>
        <h2 class="mt-3 font-display text-4xl uppercase leading-none sm:text-5xl">
          Calidad que se nota.<br />Resistencia que perdura.
        </h2>
      </div>
      <p class="max-w-md text-stone">
        Detrás de cada pedido hay un proyecto, una inversión y un compromiso. Por eso entregamos producto y un servicio que se puede sostener en obra.
      </p>
    </div>

    <div class="mt-12 grid gap-px bg-white/10 sm:grid-cols-2 lg:grid-cols-3">
      {reasons.map((reason, index) => (
        <article class="bg-ink p-7">
          <p class="font-display text-sm tracking-[0.2em] text-stone">0{index + 1}</p>
          <h3 class="mt-3 font-display text-2xl uppercase">{reason.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-stone">{reason.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
