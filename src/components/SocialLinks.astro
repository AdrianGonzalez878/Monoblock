---
import { site } from "../data/site";

interface Props {
  tone?: "dark" | "light";
}

const tone = Astro.props.tone ?? "light";
const iconClass = tone === "dark" ? "text-stone hover:text-white" : "text-ink hover:text-brand";
---

<div class="flex items-center gap-3">
  <a
    href={site.social.facebook}
    target="_blank"
    rel="noreferrer"
    class:list={["inline-flex h-10 w-10 items-center justify-center border transition", iconClass, tone === "dark" ? "border-white/15" : "border-stone"]}
    aria-label="Facebook"
  >
    <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true">
      <path d="M14.5 8.5h2V5.6c-.4-.1-1.5-.2-2.7-.2-2.7 0-4.5 1.6-4.5 4.6V12H7v3.1h2.3V22h3.5v-6.9H16L16.5 12h-3.7V10.2c0-.9.3-1.7 1.7-1.7Z"></path>
    </svg>
  </a>
  <a
    href={site.social.instagram}
    target="_blank"
    rel="noreferrer"
    class:list={["inline-flex h-10 w-10 items-center justify-center border transition", iconClass, tone === "dark" ? "border-white/15" : "border-stone"]}
    aria-label="Instagram"
  >
    <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true">
      <path d="M8 3.5h8A4.5 4.5 0 0 1 20.5 8v8A4.5 4.5 0 0 1 16 20.5H8A4.5 4.5 0 0 1 3.5 16V8A4.5 4.5 0 0 1 8 3.5Zm0 1.7A2.8 2.8 0 0 0 5.2 8v8A2.8 2.8 0 0 0 8 18.8h8A2.8 2.8 0 0 0 18.8 16V8A2.8 2.8 0 0 0 16 5.2H8Zm8.4 1.3a1 1 0 1 1 0 2 1 1 0 0 1 0-2ZM12 8.2A3.8 3.8 0 1 1 8.2 12 3.8 3.8 0 0 1 12 8.2Zm0 1.6A2.2 2.2 0 1 0 14.2 12 2.2 2.2 0 0 0 12 9.8Z"></path>
    </svg>
  </a>
  <a
    href={site.social.tiktok}
    target="_blank"
    rel="noreferrer"
    class:list={["inline-flex h-10 w-10 items-center justify-center border transition", iconClass, tone === "dark" ? "border-white/15" : "border-stone"]}
    aria-label="TikTok"
  >
    <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true">
      <path d="M14.2 3.2c.5 3.1 2.4 4.6 4.6 4.8v2.6c-1.5 0-3-.5-4.3-1.4v6.5a6.1 6.1 0 1 1-6.1-6.1c.3 0 .6 0 .9.1v2.7a3.4 3.4 0 1 0 2.4 3.3V3.2h2.5Z"></path>
    </svg>
  </a>
</div>
