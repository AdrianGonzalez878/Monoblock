---
import { site } from "../data/site";
import SocialLinks from "./SocialLinks.astro";
---

<section id="contacto" class="scroll-mt-20 bg-sand py-20 lg:py-28">
  <div class="mx-auto grid max-w-7xl gap-10 px-5 lg:grid-cols-[1fr_1.1fr] lg:px-8">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-brand">Contacto</p>
      <h2 class="mt-3 font-display text-4xl uppercase leading-none text-ink sm:text-5xl">
        Cotiza directo de fábrica
      </h2>
      <p class="mt-4 text-concrete">
        Cuéntanos el producto, la medida y el volumen. Te respondemos por WhatsApp o teléfono.
      </p>

      <ul class="mt-8 space-y-5 text-sm">
        <li>
          <p class="font-semibold uppercase tracking-wider text-concrete">Ubicación</p>
          <p class="mt-1 text-ink">{site.address}</p>
        </li>
        <li>
          <p class="font-semibold uppercase tracking-wider text-concrete">Teléfono / WhatsApp</p>
          <a href={site.phoneHref} class="mt-1 block text-ink hover:text-brand">{site.phone}</a>
        </li>
        <li>
          <p class="font-semibold uppercase tracking-wider text-concrete">Correo</p>
          <a href={`mailto:${site.email}`} class="mt-1 block text-ink hover:text-brand">{site.email}</a>
        </li>
        <li>
          <p class="font-semibold uppercase tracking-wider text-concrete">Redes</p>
          <div class="mt-2">
            <SocialLinks tone="light" />
          </div>
        </li>
      </ul>
    </div>

    <div class="bg-white p-6 shadow-sm lg:p-8">
      <h3 class="font-display text-2xl uppercase text-ink">Solicitar cotización</h3>
      <form class="mt-6 space-y-4" data-quote-form>
        <label class="block text-sm">
          <span class="font-medium text-charcoal">Nombre</span>
          <input
            required
            name="nombre"
            class="mt-1 w-full border border-stone bg-sand px-3 py-3 outline-none focus:border-brand"
          />
        </label>
        <label class="block text-sm">
          <span class="font-medium text-charcoal">Teléfono</span>
          <input
            required
            name="telefono"
            type="tel"
            class="mt-1 w-full border border-stone bg-sand px-3 py-3 outline-none focus:border-brand"
          />
        </label>
        <label class="block text-sm">
          <span class="font-medium text-charcoal">Producto o medida</span>
          <input
            name="producto"
            placeholder="Ej. block hueco 15x20x40, adoquín hexagonal..."
            class="mt-1 w-full border border-stone bg-sand px-3 py-3 outline-none focus:border-brand"
          />
        </label>
        <label class="block text-sm">
          <span class="font-medium text-charcoal">Mensaje</span>
          <textarea
            name="mensaje"
            rows="4"
            class="mt-1 w-full border border-stone bg-sand px-3 py-3 outline-none focus:border-brand"
          ></textarea>
        </label>
        <button
          type="submit"
          class="w-full bg-brand px-5 py-3.5 text-sm font-semibold text-white transition hover:bg-brand-hot"
        >
          Enviar por WhatsApp
        </button>
        <p class="text-xs text-concrete">
          Si requieres factura se agrega IVA. Pedidos sujetos a confirmación y tiempos de fabricación.
        </p>
      </form>
    </div>
  </div>

</section>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-quote-form]");

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const nombre = String(data.get("nombre") ?? "");
    const telefono = String(data.get("telefono") ?? "");
    const producto = String(data.get("producto") ?? "");
    const mensaje = String(data.get("mensaje") ?? "");

    const text = [
      "Hola, quiero cotizar con MONOBLOCK BLOQUERA.",
      `Nombre: ${nombre}`,
      `Teléfono: ${telefono}`,
      producto ? `Producto: ${producto}` : "",
      mensaje ? `Mensaje: ${mensaje}` : "",
    ]
      .filter(Boolean)
      .join("\n");

    window.open(`https://wa.me/5219514716357?text=${encodeURIComponent(text)}`, "_blank");
  });
</script>
