---
import { site, whatsappHref } from "../data/site";

const links = [
  { href: "#productos", label: "Productos" },
  { href: "#nosotros", label: "Nosotros" },
  { href: "#catalogo", label: "Catálogo" },
  { href: "#galeria", label: "Galería" },
  { href: "#contacto", label: "Contacto" },
];
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-ink/90 backdrop-blur-md" data-site-header>
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-3 lg:px-8">
    <a href="#inicio" class="flex items-center gap-3" aria-label={site.name}>
      <img
        src="/images/logo-oficial.png"
        alt=""
        class="h-12 w-12 object-cover object-[center_18%] bg-white p-1"
      />
      <span class="leading-none">
        <span class="block font-display text-lg tracking-wide text-white">
          MONO<span class="text-brand">BLOCK</span>
        </span>
        <span class="block text-[10px] font-semibold tracking-[0.38em] text-stone">BLOQUERA</span>
      </span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Principal">
      {links.map((link) => (
        <a
          href={link.href}
          class="text-sm font-medium text-stone transition hover:text-white"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={whatsappHref()}
        class="hidden rounded-sm bg-brand px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-hot sm:inline-flex"
      >
        Cotizar
      </a>
      <button
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center border border-white/20 text-white lg:hidden"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Abrir menú"
      >
        <span class="sr-only">Menú</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="hidden border-t border-white/10 px-5 py-4 lg:hidden" data-mobile-nav>
    <div class="flex flex-col gap-3">
      {links.map((link) => (
        <a href={link.href} class="py-1 text-sm font-medium text-stone hover:text-white">
          {link.label}
        </a>
      ))}
      <a href={whatsappHref()} class="mt-2 bg-brand px-4 py-3 text-center text-sm font-semibold text-white">
        Cotizar por WhatsApp
      </a>
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector("[data-site-header]");
  const toggle = document.querySelector("[data-menu-toggle]");
  const nav = document.querySelector("[data-mobile-nav]");

  const closeMenu = () => {
    nav?.classList.add("hidden");
    toggle?.setAttribute("aria-expanded", "false");
  };

  const isMenuOpen = () => nav !== null && !nav.classList.contains("hidden");

  toggle?.addEventListener("click", (event) => {
    event.stopPropagation();
    const open = nav?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
  });

  nav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      closeMenu();
    });
  });

  document.addEventListener("click", (event) => {
    if (!isMenuOpen()) return;
    const target = event.target;
    if (!(target instanceof Node)) return;
    if (header?.contains(target)) return;
    closeMenu();
  });
</script>
