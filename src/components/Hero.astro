---
import { site, whatsappHref } from "../data/site";
---

<section id="inicio" class="relative isolate min-h-[88vh] scroll-mt-20 overflow-hidden bg-ink text-white">
  <img
    src="/images/hero.jpg"
    alt="Block hueco de concreto en patio de MONOBLOCK BLOQUERA, Oaxaca"
    class="absolute inset-0 h-full w-full object-cover object-center"
    fetchpriority="high"
  />
  <div class="absolute inset-0 bg-gradient-to-r from-ink/80 via-ink/45 to-ink/15"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-ink/75 via-transparent to-ink/25"></div>

  <div class="relative mx-auto flex min-h-[88vh] max-w-7xl flex-col justify-end px-5 pb-16 pt-28 lg:px-8 lg:pb-20">
    <p class="mb-4 text-xs font-semibold uppercase tracking-[0.35em] text-stone">
      {site.factoryLine}
    </p>
    <h1 class="max-w-4xl font-display text-5xl uppercase leading-[0.95] sm:text-6xl lg:text-7xl">
      Construye fuerte,<br />
      <span class="text-stone">construye seguro.</span>
    </h1>
    <p class="mt-6 max-w-xl text-base leading-relaxed text-stone sm:text-lg">
      Bloquera en San Agustín Yatareni, Oaxaca. Fabricamos y comercializamos productos de
      concreto vibrocomprimidos: block, tabicón, adoquín y prefabricados, con resistencia,
      uniformidad y entrega confiable.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a
        href={whatsappHref()}
        class="inline-flex items-center justify-center bg-white px-6 py-3.5 text-sm font-semibold text-ink transition hover:bg-stone"
      >
        Cotizar por WhatsApp
      </a>
      <a
        href="#productos"
        class="inline-flex items-center justify-center border border-white/30 px-6 py-3.5 text-sm font-semibold text-white transition hover:border-white"
      >
        Ver productos
      </a>
    </div>
    <div class="mt-10 grid max-w-xl grid-cols-1 gap-4 border-t border-white/15 pt-6 text-sm text-stone sm:grid-cols-2">
      <p><span class="block font-display text-lg tracking-wide text-white">Oaxaca</span>San Agustín Yatareni</p>
      <p><span class="block font-display text-lg tracking-wide text-white">{site.phone}</span>Cotizaciones y pedidos</p>
    </div>
  </div>
</section>
